{
  "manifest_version": 2,
  "id": "ling.tts-bot",
  "version": "2.3.1",
  "name": "TTS语音插件",
  "description": "MiMo v2.5 音色克隆语音合成，支持语音优先、随机和只发语音三种热重载模式。",
  "author": { "name": "Ling-LA", "url": "https://github.com/Ling-LA" },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Ling-LA/ling-tts-bot",
    "homepage": "https://github.com/Ling-LA/ling-tts-bot",
    "documentation": "https://github.com/Ling-LA/ling-tts-bot/blob/main/README.md",
    "issues": "https://github.com/Ling-LA/ling-tts-bot/issues"
  },
  "host_application": { "min_version": "1.0.0", "max_version": "1.99.99" },
  "sdk": { "min_version": "2.0.0", "max_version": "2.99.99" },
  "dependencies": [
    { "type": "python_package", "name": "aiohttp", "version_spec": ">=3.0" }
  ],
  "capabilities": ["send.custom"],
  "i18n": { "default_locale": "zh-CN", "supported_locales": ["zh-CN"] }
}
